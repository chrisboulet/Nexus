# NEXUS - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Supabase (pour développement local seulement)
# Note: En production (Edge Functions), SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY
# sont fournis automatiquement par Supabase - pas besoin de les ajouter aux Secrets!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Limitless API
# Get your API key from: https://limitless.ai/developers
LIMITLESS_API_KEY=lim_xxxxxxxxxxxx
LIMITLESS_ENDPOINT=https://api.limitless.ai/v1

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Notion API
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxx
NOTION_WORKSPACE_ID=a8803c33-4e63-816d-a693-0003102f3eb9
NOTION_PRIORITIES_DATABASE_ID=4d7998e63e3d4713861c1da6e13dd77b

# Google Tasks API
# 1. Create project in Google Cloud Console
# 2. Enable Google Tasks API
# 3. Create Service Account
# 4. Download credentials.json and paste stringified JSON below
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_TASKS_LIST_ID=your-tasks-list-id

# Logging & Monitoring
LOG_LEVEL=info
